export type SignCategory =
  | "greetings"
  | "alphabet"
  | "numbers"
  | "commonPhrases"
  | "emotions"
  | "dailyActivities";

export interface Sign {
  id: string;
  category: SignCategory;
  wordEn: string;
  wordTl: string;
  descriptionEn: string;
  descriptionTl: string;
  steps: string[];
  stepsTl: string[];
  difficulty: "easy" | "medium" | "hard";
  relatedSigns: string[];
  emoji?: string;
}

