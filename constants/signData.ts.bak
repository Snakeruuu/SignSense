export const categories: {
  id: SignCategory;
  iconName: string;
  signCount: number;
}[] = [
  { id: "greetings", iconName: "smile", signCount: 13 },
  { id: "alphabet", iconName: "type", signCount: 26 },
  { id: "numbers", iconName: "hash", signCount: 10 },
  { id: "commonPhrases", iconName: "message-circle", signCount: 20 },
  { id: "emotions", iconName: "heart", signCount: 9 },
  { id: "dailyActivities", iconName: "sun", signCount: 13 },
];

export const getSignsByCategory = (category: SignCategory): Sign[] => {
  return signs.filter((sign) => sign.category === category);
};

export const getSignById = (id: string): Sign | undefined => {
  return signs.find((sign) => sign.id === id);
};

export const searchSigns = (query: string, language: "en" | "tl"): Sign[] => {
  const lowercaseQuery = query.toLowerCase();
  return signs.filter((sign) => {
    const word = language === "en" ? sign.wordEn : sign.wordTl;
    const description =
      language === "en" ? sign.descriptionEn : sign.descriptionTl;
    return (
      word.toLowerCase().includes(lowercaseQuery) ||
      description.toLowerCase().includes(lowercaseQuery)
    );
  });
};
