# SignSpeak Environment Configuration
# Copy this file to .env and update values as needed

# Backend API (optional, for gesture recognition server)
# REACT_APP_API_URL=http://localhost:5000

# MediaPipe Configuration (optional)
# MEDIAPIPE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker.task

# Feature Flags
# REACT_APP_ENABLE_REAL_GESTURE_RECOGNITION=true
# REACT_APP_DEBUG_MODE=false

# Analytics (optional)
# REACT_APP_ANALYTICS_ID=

# App Version
REACT_APP_VERSION=1.0.0
REACT_APP_NAME=SignSpeak
